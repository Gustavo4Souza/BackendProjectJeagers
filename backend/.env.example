# ── Database ──────────────────────────────────────────────────
# Local Docker Compose:
DATABASE_URL=postgresql+psycopg2://jeagers:jeagers@db:5432/jeagers
# Railway (managed PostgreSQL) — Railway sets this automatically when
# you attach a Postgres service; no change needed in most cases.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Railway Redis: set to the value from the Redis service dashboard.

# ── Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
